    "travar-fases": "tsx scripts/conferir-fases.ts --travar",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/mali": "^5.3.0"
  }
}
