{
  "name": "adesivos-line",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "recortar": "tsx scripts/recortar.ts",
    "recortar:debug": "tsx scripts/recortar.ts --debug",
    "dev": "npm run recortar && vite --host",
    "build": "npm run recortar && npm run conferir && tsc --noEmit && vite build",
